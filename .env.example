# Postgres credentials (used by docker-compose and DATABASE_URL below)
POSTGRES_USER=keyloop
POSTGRES_PASSWORD=keyloop
POSTGRES_DB=keyloop

DATABASE_URL=postgresql://keyloop:keyloop@localhost:5432/keyloop
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
PORT=3000

# SMTP for email notifications
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@keyloop.local
SMTP_USER=
SMTP_PASS=

# Outbox worker poll interval in ms
OUTBOX_INTERVAL_MS=5000
