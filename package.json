{
  "name": "keyloop-assessment",
  "version": "1.0.0",
  "description": "Vehicle service appointment scheduling API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "DATABASE_URL=postgresql://keyloop:keyloop@localhost:5433/keyloop_test jest --runInBand",
    "test:unit": "jest tests/unit",
    "test:int": "DATABASE_URL=postgresql://keyloop:keyloop@localhost:5433/keyloop_test jest tests/integration --runInBand",
    "lint": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.0.3",
      "onFail": "download"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "esbuild",
      "prisma",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "axios": "^1.15.2",
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.7",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.0",
    "@types/supertest": "^7.2.0",
    "jest": "^30.3.0",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
